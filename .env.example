# ==============================================================================
# SoSparkDesigns Next.js — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development or configure in your
# hosting environment (Vercel, Render, Cloudflare Pages/Workers, etc.)
# NEVER commit real credentials or secrets to git.
# ==============================================================================

# ── 1. Canonical Site & Application Environment ──────────────────────────────
# Base URL used for metadata, Open Graph, sitemap, and robots.txt generation
NEXT_PUBLIC_SITE_URL=https://sosparkdesigns.com

# Deployment environment: 'production' | 'staging' | 'development'
# In staging, Next.js sets robots: noindex, nofollow and disables production sitemap
NEXT_PUBLIC_APP_ENV=development

# Runtime environment
NODE_ENV=development
PORT=3000

# ── 2. Database Configuration (MongoDB Atlas / Mongoose) ────────────────────
# Production: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sospark_prod?retryWrites=true&w=majority
# Staging:    mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sospark_staging?retryWrites=true&w=majority
# Local:      mongodb://127.0.0.1:27017/sosparkdesign
MONGODB_URI=mongodb://127.0.0.1:27017/sosparkdesign

# Staging isolation guard: Set to 'true' to dry-run contact submissions in staging
# without persisting test records to the production database
STAGING_ISOLATION=false

# ── 3. Security & Cryptographic Secrets ──────────────────────────────────────
# High-entropy random secret for admin JWT session token signing (64+ chars)
JWT_SECRET=your_jwt_secret_minimum_32_characters_random_hex

# 32-byte (64 hex characters) encryption key for sensitive credentials
API_KEY_ENCRYPTION_SECRET=your_32_byte_hex_encryption_secret_0123456789abcdef0123456789abcdef

# ── 4. CORS & Cross-Origin Security ──────────────────────────────────────────
# Permitted client origin for API route validation
CORS_ORIGIN=http://localhost:3000

# ── 5. Optional Integrations ─────────────────────────────────────────────────
# Groq API key for the AI assistant widget (optional in development/staging)
GROQ_API_KEY=your_groq_api_key_here
